FROM node:20-slim
# Prisma's query engine links against libssl, which node:*-slim does not ship.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@9.5.0 --activate

WORKDIR /app

# The schema, its migrations, and prisma.config.ts all live inside @kc/db now,
# so they arrive with `packages`. The root `prisma/` and `prisma.config.ts` this
# used to copy no longer exist — the first was a stale duplicate that had drifted
# to Postgres SQL, and both are gone.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY scripts ./scripts

ARG DATABASE_URL=postgresql://placeholder@localhost:26257/placeholder
ENV DATABASE_URL=$DATABASE_URL

RUN pnpm install --frozen-lockfile

CMD ["node", "scripts/migrate.mjs", "deploy"]
