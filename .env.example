# Copy to .env and fill the values marked below.
#
# Only OPENAI_API_KEY is strictly required — everything else either has a working
# default or is derived at startup. The blanks are the ones you must supply.

# ── Required ─────────────────────────────────────────────────────────────────
# A real AWS Bedrock API key. Reused as AWS_BEARER_TOKEN_BEDROCK below, because
# one key is valid for both Bedrock Mantle (chat) and bedrock-runtime (embeddings).
OPENAI_API_KEY=
OPENAI_BASE_URL="https://bedrock-mantle.ap-southeast-3.api.aws/v1"
BEDROCK_MODEL="zai.glm-5"
BEDROCK_PROJECT=

# ── Database ─────────────────────────────────────────────────────────────────
# One URL, two consumers: SQLAlchemy rewrites the scheme to cockroachdb+asyncpg,
# Prisma takes the plain postgresql form. Everything lives in the `kc` schema,
# because this database is shared with an unrelated project whose tables are in
# `public` — see the Database notes in README.md before touching migrations.
#
# For CockroachDB Cloud, replace this with the cluster's connection string; it
# will carry ?sslmode=verify-full and a cluster name.
COCKROACH_URL="postgresql://root@localhost:26257/knowledge_base?sslmode=disable"
REDIS_URI="redis://:redispw123@localhost:6379/0"

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Origins allowed to mint a token from a signed-in session, beyond the app.
# This is how the browser extension works. Empty means no extension can save.
# A wildcard would let ANY installed extension turn a session into a workspace
# token, so ids are listed explicitly. The id changes when the extension is
# repacked — see apps/extension/README.md.
BETTER_AUTH_TRUSTED_ORIGINS=

# The agent→API write endpoints. Published default is "dev-internal-token";
# startup warns loudly while that is in use.
INTERNAL_API_TOKEN=

# Anonymous reads/writes. Off means every request carries a workspace token.
ALLOW_ANONYMOUS="false"
# Rows written before workspaces existed carry this owner. Nothing new uses it.
DEFAULT_USER_ID="legacy"

# ── Object storage ───────────────────────────────────────────────────────────
# Uploaded PDFs are archived here so a page citation stays checkable after the
# text has been compiled away. Named S3_* rather than MINIO_* on purpose: MinIO
# speaks the S3 API, so moving to real S3 is a change of endpoint and keys, not
# a change of code. For AWS S3, drop S3_ENDPOINT_URL and set a real S3_REGION.
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET="knowledge-compiler"
S3_REGION="us-east-1"

# ── Embeddings ───────────────────────────────────────────────────────────────
# Both are derived from the two required variables above and are left unset on
# purpose. .env performs no variable expansion, so writing ${OPENAI_API_KEY}
# here hands Bedrock that literal string — it answers "Invalid API Key format"
# and the embedder silently falls back to the local ONNX model. Uncomment only
# to point embeddings at a different key or region than the chat model uses.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=

# auto probes Cohere → Titan → local ONNX across both regions and logs the winner.
EMBEDDING_PROVIDER="auto"
EMBEDDING_FALLBACK_REGION="ap-southeast-1"
EMBEDDING_DIM=1024
# Cohere must be invoked through an inference profile id; the bare
# cohere.embed-v4:0 rejects on-demand throughput.
COHERE_EMBEDDING_MODEL_ID="global.cohere.embed-v4:0"
EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# Left unset on purpose: the threshold follows whichever provider answered,
# because the models disagree sharply about what a score means (Cohere 0.40,
# Titan 0.78, bge-small 0.70). Uncomment only to pin one — an empty value is a
# parse error, not "unset".
# MATCH_THRESHOLD=
MATCH_TOP_K=5

# ── Services ─────────────────────────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT=8000
MASTRA_URL="http://localhost:4111"
MASTRA_PORT=4111
INTERNAL_API_URL="http://localhost:8000"
VITE_MASTRA_URL="http://localhost:4111"
VITE_API_URL="http://localhost:8000"

# ── Behaviour ────────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=2
LOG_LEVEL="INFO"

# Spend ceilings, per workspace per hour. Every save is a model call and a long
# PDF is several, so these bound the bill rather than police abuse.
COMPILE_RATE_LIMIT_PER_HOUR=120
ASK_RATE_LIMIT_PER_HOUR=240

# ── AI usage log ─────────────────────────────────────────────────────────────
# What a model call costs, in USD per MILLION tokens. Optional.
#
# Left empty on purpose: a rate depends on your region and account and changes
# without notice, so the app will not guess one. With nothing set, the AI Logs
# page reports token counts and shows cost as unknown — which is honest. A
# hardcoded default would render a wrong number that looks authoritative.
#
# Look yours up at https://aws.amazon.com/bedrock/pricing/ for the region you
# actually run in, then set it as one line of JSON. Embedding models have no
# output tokens; omit "output" for them.
#
# Names are matched loosely — punctuation and case are ignored, and a name that
# appears inside the recorded id is enough. So "cohere-embed-v4" matches the
# `bedrock:global.cohere.embed-v4:0@ap-southeast-3` an embedding row actually
# stores, and you do not have to reproduce that string. Use at least four
# characters; shorter names are only matched exactly.
#
# Two things worth knowing after you set this:
#   - Cost is worked out when a row is written, so existing rows keep reading as
#     unknown. Run `uv run python -m app.reprice --write` in apps/api to update
#     them.
#   - Restart the API. Rates are read once at boot, so that two rows never
#     disagree about what a token cost with no record of why.
#
# AI_PRICING={"zai.glm-5":{"input":0.0,"output":0.0},"cohere-embed-v4":{"input":0.0}}
AI_PRICING=
