# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — copy this file to .env and fill in OPENAI_API_KEY.
# Everything below this block is optional and has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# Database Credentials
DATABASE_URL="postgresql://postgres:postgrespw123@localhost:5432/knowledge_base"
COCKROACH_URL="postgresql://root@localhost:26257/knowledge_base?sslmode=disable"
REDIS_URI="redis://:redispw123@localhost:6379/0"

# AWS Bedrock Mantle (GLM-5 Model) Configuration via OpenAI SDK
OPENAI_API_KEY="your-bedrock-mantle-api-key"
OPENAI_BASE_URL="https://bedrock-mantle.ap-southeast-3.api.aws/v1"
BEDROCK_MODEL="zai.glm-5"
BEDROCK_PROJECT="default"

VITE_API_URL="http://localhost:8000"


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — all of these are derived from the block above at startup.
# Uncomment only to override.
# ─────────────────────────────────────────────────────────────────────────────

# --- Embeddings -------------------------------------------------------------
# Bedrock Mantle exposes no /v1/embeddings endpoint, so embeddings go through
# the separate bedrock-runtime service via boto3. A Bedrock API key is valid for
# both, so OPENAI_API_KEY is reused as AWS_BEARER_TOKEN_BEDROCK automatically
# and AWS_REGION is parsed out of OPENAI_BASE_URL. Override only if the key or
# region for embeddings differs from the one used for chat.
# AWS_BEARER_TOKEN_BEDROCK=""
# AWS_REGION="ap-southeast-3"

# Which embedding model exists depends on the region, so the API probes a chain
# at startup and uses the first that answers. Whichever wins is logged at boot
# and recorded per-row in `embedding_model`.
#   1. bedrock  — Cohere Embed v4 in AWS_REGION
#   2. bedrock  — Cohere Embed v4 in EMBEDDING_FALLBACK_REGION
#   3. bedrock  — Titan v2 in either region (US only; absent from APAC)
#   4. local    — BAAI/bge-small-en-v1.5 via fastembed, no network or credentials
# All emit 1024-dim vectors, so VECTOR(1024) holds any of them.
#
# Measured against this account: ap-southeast-3 lists exactly one embedding model
# (Cohere v4) and ap-southeast-1 lists three — none of them Titan. Titan only
# appears in the US regions.
# EMBEDDING_PROVIDER="auto"          # auto | bedrock | local
# EMBEDDING_FALLBACK_REGION="ap-southeast-1"
# EMBEDDING_DIM="1024"
#
# Cohere must be addressed through an inference profile id; the bare
# "cohere.embed-v4:0" rejects on-demand throughput.
# COHERE_EMBEDDING_MODEL_ID="global.cohere.embed-v4:0"
# EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# --- Services ---------------------------------------------------------------
# API_HOST="0.0.0.0"
# API_PORT="8000"
#
# The web app's port is not read from here — it is set in apps/web/vite.config.ts
# and the `dev` script, because Vite needs it before any env file is loaded.

# Mastra agent service. The API posts to {MASTRA_URL}/api/workflows/...
# MASTRA_URL="http://localhost:4111"
# MASTRA_PORT="4111"      # the port the agent binds; keep in step with MASTRA_URL

# How the Mastra agent calls back into the Python API. The agent never touches
# the database directly — it reads and writes only through these endpoints.
# INTERNAL_API_URL="http://localhost:8000"
# Shared secret for the agent->API write endpoints. The built-in default is
# published in this repository, so localhost-only development may leave this
# unset - anything reachable beyond localhost must not. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_TOKEN=

# --- Auth ---------------------------------------------------------------------
# Better Auth runs inside the web app and owns the  schema. The API only
# ever verifies its JWTs against {AUTH_BASE_URL}/api/auth/jwks — it never reads
# Better Auth's tables, so the two services migrate independently.
# BETTER_AUTH_SECRET=""            # required; generate with: openssl rand -base64 32
# BETTER_AUTH_URL="http://localhost:3000"
# AUTH_BASE_URL="http://localhost:3000"
# AUTH_AUDIENCE="knowledge-compiler-api"

# Escape hatch that lets unauthenticated callers act as the 'legacy' workspace.
# Exists only so the app keeps working while the frontend is wired up.
# MUST be false before anyone but you can reach the API.
# ALLOW_ANONYMOUS="false"

# --- Behaviour --------------------------------------------------------------
# Single-user demo identity (PRD §5 non-goals: no multi-user auth for MVP).
# DEFAULT_USER_ID="00000000-0000-0000-0000-000000000001"

# Cosine similarity above which a new item merges into an existing page instead
# of creating a new one. Lower = more aggressive merging.
#
# LEAVE THIS COMMENTED unless you are deliberately tuning. By default the value
# follows whichever embedding provider won the startup probe, because models
# disagree about what a similarity score means:
#
#   bedrock / Cohere Embed v4     0.40   (unrelated text sits near 0.24)
#   bedrock / Titan v2            0.78
#   local / bge-small-en-v1.5     0.70   (unrelated text sits near 0.48)
#
# These are not interchangeable. Cohere scores far lower in absolute terms, so
# setting 0.78 while running on Cohere merges nothing at all and every save
# creates a duplicate page. The active value is shown at GET /health.
# MATCH_THRESHOLD=
# MATCH_TOP_K="5"

# Retries for an LLM step whose output fails zod validation, before the compile
# run is marked failed with the raw output kept for inspection.
# LLM_MAX_RETRIES="2"

# LOG_LEVEL="INFO"

# --- Seeding (optional) -----------------------------------------------------
# `pnpm seed` writes into a real workspace, so it needs an identity. Either an
# account's credentials, or a token copied from /api/auth/token while signed in.
# SEED_EMAIL=
# SEED_PASSWORD=
# SEED_TOKEN=
