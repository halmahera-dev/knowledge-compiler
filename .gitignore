node_modules/
dist/
.output/
.nitro/
.tanstack/
.mastra/
mastra.db
mastra.db-*
.turbo/
.vinxi/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Env — .env holds real credentials, never commit it.
# Everything .env* is ignored and .env.example opted back in, rather than listing
# variants: `pnpm ccloud use` writes .env.local-backup containing a Cloud
# connection string with its password, and a rule naming only the files that
# existed when it was written would not have covered it.
.env
.env.*
!.env.example

# Local model cache for the embedding fallback
.cache/
apps/api/.model-cache/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# npm was used once at the start; this repo is pnpm (see packageManager in
# package.json). A stray npm lockfile makes CI and hosting providers pick the
# wrong package manager, and then resolve different versions than anyone tested.
package-lock.json
yarn.lock
