{
  "name": "kc",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:client": "turbo run dev -F client",
    "dev:api": "turbo run dev -F api",
    "dev:agent": "turbo run dev -F agent",
    "db:push": "turbo run db:push -F @kc/db",
    "db:studio": "turbo run db:studio -F @kc/db",
    "db:generate": "turbo run db:generate -F @kc/db",
    "db:migrate": "turbo run db:migrate -F @kc/db",
    "check": "biome check --write ."
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "@prisma/dev": "0.25.1"
    }
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@kc/env": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@kc/config": "workspace:*",
    "turbo": "^2.10.7",
    "@biomejs/biome": "^2.5.6"
  }
}
