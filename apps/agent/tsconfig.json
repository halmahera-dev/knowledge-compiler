{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@kc/env/*": [
        "../../packages/env/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
