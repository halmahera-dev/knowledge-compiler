{
  "manifest_version": 3,
  "name": "Knowledge Compiler",
  "version": "0.1.0",
  "description": "Clip the page you're reading into your compiled knowledge base.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Knowledge Compiler"
  }
}
