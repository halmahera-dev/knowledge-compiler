{
  "manifest_version": 3,
  "name": "Traversa",
  "version": "0.3.0",
  "description": "Save what you are reading into your compiled knowledge base, from the toolbar or the right-click menu.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:8000/*",
    "http://34.228.186.46:3000/*",
    "http://34.228.186.46:8000/*",
    "http://18.235.24.198:3000/*",
    "http://18.235.24.198:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Traversa",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
